//Backend.SLICC.ModularSLICC.dir.GenDirHeader
machine(MachineType:Directory, "Directory protocol")
:

  DirectoryMemory *directory;
  // The following latencies should be exposed as command-line parameters in a future update
  Cycles toMemLatency := 1;
  Cycles responseLatency := 6;
  Cycles recycleLatency := 10;

  // Required networks
  MessageBuffer *requestToMemory;
  MessageBuffer *responseFromMemory;

  // Dynamic networks
  MessageBuffer *fwd2To, network="From", virtual_network="0", vnet_type="fwd2";
  MessageBuffer *fwd2From, network="To", virtual_network="0", vnet_type="fwd2";
  MessageBuffer *resp2To, network="From", virtual_network="1", vnet_type="resp2";
  MessageBuffer *resp2From, network="To", virtual_network="1", vnet_type="resp2";
  MessageBuffer *req2To, network="From", virtual_network="2", vnet_type="req2";
  MessageBuffer *req2From, network="To", virtual_network="2", vnet_type="req2";

{
  //Backend.SLICC.ModularSLICC.dir.GenDirStateDecl
  state_declaration(State, desc="Directory states", default="Directory_State_I") {
    E, AccessPermission:Maybe_Stale, desc="... TODO ...";
    I, AccessPermission:Read_Write, desc="... TODO ...";
    M, AccessPermission:Maybe_Stale, desc="... TODO ...";
    O, AccessPermission:Read_Only, desc="... TODO ...";
    S, AccessPermission:Read_Only, desc="... TODO ...";
    E_PutML1_0, AccessPermission:Busy, desc="... TODO ...";
    I_GetML1_0, AccessPermission:Busy, desc="... TODO ...";
    I_GetSL1_0, AccessPermission:Busy, desc="... TODO ...";
    I_PutOL1_0, AccessPermission:Busy, desc="... TODO ...";
    M_PutEL1_0, AccessPermission:Busy, desc="... TODO ...";
    M_PutML1_0, AccessPermission:Busy, desc="... TODO ...";
    M_PutOL1_0, AccessPermission:Busy, desc="... TODO ...";
    M_PutSL1_0, AccessPermission:Busy, desc="... TODO ...";
    O_GetML1_0, AccessPermission:Busy, desc="... TODO ...";
    O_PutML1_0, AccessPermission:Busy, desc="... TODO ...";
    O_PutOL1_0, AccessPermission:Busy, desc="... TODO ...";
    S_GetML1_0, AccessPermission:Busy, desc="... TODO ...";
    S_GetML1_1, AccessPermission:Busy, desc="... TODO ...";
    S_GetML1_2, AccessPermission:Busy, desc="... TODO ...";
    S_GetSL1_0, AccessPermission:Busy, desc="... TODO ...";
  }
  
  //Backend.SLICC.ModularSLICC.dir.GenDirEvents
  enumeration(Event, desc="Directory events") {
    StallmemQueue_in, desc="Stall the memQueue_in port.";
    
    Stallfwd2to_in, desc="Stall the fwd2to_in port.";
    
    Stallreq2to_in, desc="Stall the req2to_in port.";
    
    Stallresp2to_in, desc="Stall the resp2to_in port.";
    
    allocTBE, desc="Allocate a new TBE.";
    
    deallocTBE, desc="Deallocate a TBE.";
    
    Progress, desc="Progress, please!";
  }
  
  //Backend.SLICC.ModularSLICC.dir.GenDirStruct
  structure(Entry, desc="Stored variables of the Directory machine", interface="AbstractCacheEntry", main="false") {
    State DirectoryState, desc="Directory state";
    DataBlock cl, desc="... TODO ...";
    NetDest cacheL1, desc="... TODO ...";
    MachineID ownerL1, desc="... TODO ...";
  }
  
  //Backend.SLICC.ModularSLICC.dir.GenDirTBE
  structure(TBE, desc="TBE entries for Directory machine") {
    State TBEState,       desc="Transient State";
  
    bool dirty, desc="... TODO ...";
  }
  
  structure(TBETable, external="yes"){
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
    bool areNSlotsAvailable(int, Tick);
  }
  
  TBETable TBEs, template="<Directory_TBE>", constructor="m_number_of_TBEs";
  
  
  //Backend.SLICC.ModularSLICC.dir.GenDirStaticFns
  Tick clockEdge();
  Tick cyclesToTicks(Cycles c);
  Cycles ticksToCycles(Tick t);
  void set_tbe(TBE a);
  void unset_tbe();
  void wakeUpAllBuffers(Addr a);
  
  Entry getEntry(Addr LineAddress), return_by_pointer="yes" {
    Entry entry := static_cast(Entry, "pointer", directory[LineAddress]);
    if (is_invalid(entry)) {
      entry := static_cast(Entry, "pointer", directory.allocate(LineAddress, new Entry));
    }
    return entry;
  }
  
  State getState(TBE tbe, Addr LineAddress) {
    if (is_valid(tbe)) {
      return tbe.TBEState;
    } else if (directory.isPresent(LineAddress)) {
      return getEntry(LineAddress).DirectoryState;
    } else {
      return State:I;
    }
  }
  
  void setState(TBE tbe, Addr LineAddress, State state) {
    DPRINTF(RubySlicc, "%s -> %s (addr: %#x)\n", getState(tbe, LineAddress), state, LineAddress);
    //if (state != getState(tbe, LineAddress)) {
    //  wakeUpAllBuffers(LineAddress);
    //}
    if (is_valid(tbe)) {
      tbe.TBEState := state;
    }
    if (directory.isPresent(LineAddress)) {
      getEntry(LineAddress).DirectoryState := state;
    }
  }
  
  AccessPermission getAccessPermission(Addr LineAddress) {
    TBE tbe := TBEs[LineAddress];
    if (is_valid(tbe)) {
      return Directory_State_to_permission(tbe.TBEState);
    } else if (directory.isPresent(LineAddress)) {
      return Directory_State_to_permission(getEntry(LineAddress).DirectoryState);
    } else {
      return AccessPermission:NotPresent;
    }
  }
  
  void setAccessPermission(Addr LineAddress, State state) {
    if (directory.isPresent(LineAddress)) {
      getEntry(LineAddress).changePermission(Directory_State_to_permission(state));
    }
  }
  
  void functionalRead(Addr LineAddress, Packet *pkt) {
    functionalMemoryRead(pkt);
  }
  
  int functionalWrite(Addr LineAddress, Packet *pkt) {
    return 0 + functionalMemoryWrite(pkt);
  }
  
  //Backend.SLICC.ModularSLICC.dir.GenDirOutPorts
  out_port(memQueue_out, MemoryMsg, requestToMemory);
  out_port(fwd2from_out, CoherenceMessage, fwd2From);
  out_port(req2from_out, CoherenceMessage, req2From);
  out_port(resp2from_out, CoherenceMessage, resp2From);
  
  //Backend.SLICC.ModularSLICC.dir.GenDirInPorts
  in_port(memQueue_in, MemoryMsg, responseFromMemory) {
    if (memQueue_in.isReady(clockEdge())) {
      peek(memQueue_in, MemoryMsg) {
        Addr LineAddress := in_msg.addr;
        TBE tbe := TBEs[LineAddress];
        State st := getState(tbe, LineAddress);
        if (st == State:E_PutML1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          setState(tbe, LineAddress, State:I);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:I_GetML1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_READ) {
          enqueue(resp2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Data;
            out_msg.Destination.add(in_msg.OriginalRequestorMachId);
            out_msg.Type := CoherenceMessageType:GetM_Ack_ADL1;
            out_msg.Sender := machineID;
            out_msg.cl := in_msg.DataBlk;
            out_msg.acksExpectedL1 := getEntry(LineAddress).cacheL1.count();
          }
          getEntry(LineAddress).ownerL1 := in_msg.OriginalRequestorMachId;
          setState(tbe, LineAddress, State:M);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:I_GetSL1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_READ) {
          enqueue(resp2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Data;
            out_msg.Destination.add(in_msg.OriginalRequestorMachId);
            out_msg.Type := CoherenceMessageType:GetM_Ack_DL1;
            out_msg.Sender := machineID;
            out_msg.cl := in_msg.DataBlk;
          }
          setState(tbe, LineAddress, State:E);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:I_PutOL1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          getEntry(LineAddress).cacheL1.remove(in_msg.OriginalRequestorMachId);
          if (getEntry(LineAddress).cacheL1.count() == 0) {
            setState(tbe, LineAddress, State:I);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
          else if (getEntry(LineAddress).cacheL1.count() != 0) {
            setState(tbe, LineAddress, State:I);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
        } else if (st == State:M_PutEL1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          setState(tbe, LineAddress, State:I);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:M_PutML1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          setState(tbe, LineAddress, State:I);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:M_PutOL1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          setState(tbe, LineAddress, State:I);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:M_PutSL1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          setState(tbe, LineAddress, State:I);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:O_GetML1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_READ) {
          enqueue(resp2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Data;
            out_msg.Destination.add(in_msg.OriginalRequestorMachId);
            out_msg.Type := CoherenceMessageType:GetM_Ack_ADL1;
            out_msg.Sender := machineID;
            out_msg.cl := in_msg.DataBlk;
            out_msg.acksExpectedL1 := getEntry(LineAddress).cacheL1.count();
          }
          if (getEntry(LineAddress).cacheL1.count() != 0) {
            enqueue(fwd2from_out, CoherenceMessage, responseLatency) {
              out_msg.LineAddress := LineAddress;
              out_msg.MessageSize := MessageSizeType:Control;
              out_msg.Destination := getEntry(LineAddress).cacheL1;
              out_msg.Type := CoherenceMessageType:InvL1;
              out_msg.Sender := in_msg.OriginalRequestorMachId;
            }
            getEntry(LineAddress).ownerL1 := in_msg.OriginalRequestorMachId;
            getEntry(LineAddress).cacheL1.clear();
            setState(tbe, LineAddress, State:M);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
          else if (getEntry(LineAddress).cacheL1.count() == 0) {
            getEntry(LineAddress).ownerL1 := in_msg.OriginalRequestorMachId;
            getEntry(LineAddress).cacheL1.clear();
            setState(tbe, LineAddress, State:M);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
        } else if (st == State:O_PutML1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          getEntry(LineAddress).cacheL1.remove(in_msg.OriginalRequestorMachId);
          if (getEntry(LineAddress).cacheL1.count() == 0) {
            setState(tbe, LineAddress, State:I);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
          else if (getEntry(LineAddress).cacheL1.count() != 0) {
            setState(tbe, LineAddress, State:S);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
        } else if (st == State:O_PutOL1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_WB) {
          
          getEntry(LineAddress).cacheL1.remove(in_msg.OriginalRequestorMachId);
          if (getEntry(LineAddress).cacheL1.count() == 0) {
            setState(tbe, LineAddress, State:I);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
          else if (getEntry(LineAddress).cacheL1.count() != 0) {
            setState(tbe, LineAddress, State:S);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
        } else if (st == State:S_GetML1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_READ) {
          enqueue(resp2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Data;
            out_msg.Destination.add(in_msg.OriginalRequestorMachId);
            out_msg.Type := CoherenceMessageType:GetM_Ack_DL1;
            out_msg.Sender := machineID;
            out_msg.cl := in_msg.DataBlk;
          }
          getEntry(LineAddress).ownerL1 := in_msg.OriginalRequestorMachId;
          getEntry(LineAddress).cacheL1.clear();
          setState(tbe, LineAddress, State:M);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:S_GetML1_1 
              && in_msg.Type == MemoryRequestType:MEMORY_READ) {
          enqueue(resp2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Data;
            out_msg.Destination.add(in_msg.OriginalRequestorMachId);
            out_msg.Type := CoherenceMessageType:GetM_Ack_ADL1;
            out_msg.Sender := machineID;
            out_msg.cl := in_msg.DataBlk;
            out_msg.acksExpectedL1 := getEntry(LineAddress).cacheL1.count();
          }
          enqueue(fwd2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Control;
            out_msg.Destination := getEntry(LineAddress).cacheL1;
            out_msg.Type := CoherenceMessageType:InvL1;
            out_msg.Sender := in_msg.OriginalRequestorMachId;
          }
          getEntry(LineAddress).ownerL1 := in_msg.OriginalRequestorMachId;
          getEntry(LineAddress).cacheL1.clear();
          setState(tbe, LineAddress, State:M);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else if (st == State:S_GetML1_2 
              && in_msg.Type == MemoryRequestType:MEMORY_READ) {
          enqueue(resp2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Data;
            out_msg.Destination.add(in_msg.OriginalRequestorMachId);
            out_msg.Type := CoherenceMessageType:GetM_Ack_ADL1;
            out_msg.Sender := machineID;
            out_msg.cl := in_msg.DataBlk;
            out_msg.acksExpectedL1 := getEntry(LineAddress).cacheL1.count();
          }
          if (getEntry(LineAddress).cacheL1.count() != 0) {
            enqueue(fwd2from_out, CoherenceMessage, responseLatency) {
              out_msg.LineAddress := LineAddress;
              out_msg.MessageSize := MessageSizeType:Control;
              out_msg.Destination := getEntry(LineAddress).cacheL1;
              out_msg.Type := CoherenceMessageType:InvL1;
              out_msg.Sender := in_msg.OriginalRequestorMachId;
            }
            getEntry(LineAddress).ownerL1 := in_msg.OriginalRequestorMachId;
            getEntry(LineAddress).cacheL1.clear();
            setState(tbe, LineAddress, State:M);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
          else if (getEntry(LineAddress).cacheL1.count() == 0) {
            getEntry(LineAddress).ownerL1 := in_msg.OriginalRequestorMachId;
            getEntry(LineAddress).cacheL1.clear();
            setState(tbe, LineAddress, State:M);
          
            memQueue_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);
          }
        } else if (st == State:S_GetSL1_0 
              && in_msg.Type == MemoryRequestType:MEMORY_READ) {
          enqueue(resp2from_out, CoherenceMessage, responseLatency) {
            out_msg.LineAddress := LineAddress;
            out_msg.MessageSize := MessageSizeType:Data;
            out_msg.Destination.add(in_msg.OriginalRequestorMachId);
            out_msg.Type := CoherenceMessageType:GetS_AckL1;
            out_msg.Sender := machineID;
            out_msg.cl := in_msg.DataBlk;
          }
          getEntry(LineAddress).cacheL1.add(in_msg.OriginalRequestorMachId);
          setState(tbe, LineAddress, State:S);
          
          memQueue_in.dequeue(clockEdge());
          trigger(Event:deallocTBE, LineAddress, tbe);
        } else {
          trigger(Event:StallmemQueue_in, LineAddress, tbe);}
      }
    }
  }
  
  in_port(fwd2to_in, CoherenceMessage, fwd2To) {
    if (fwd2to_in.isReady(clockEdge())) {
      peek (fwd2to_in, CoherenceMessage, block_on="LineAddress") {
        Addr LineAddress := in_msg.LineAddress;
        TBE tbe := TBEs[LineAddress];
        State st := getState(tbe, LineAddress);
        DPRINTF(RubySlicc, "fwd2to_in: %s %s %s (addr: %#x)\n", in_msg.Type, in_msg.Sender, st, LineAddress);
        error("Invalid transition");
      }
    }
  }
  
  in_port(resp2to_in, CoherenceMessage, resp2To) {
    if (resp2to_in.isReady(clockEdge())) {
      peek (resp2to_in, CoherenceMessage, block_on="LineAddress") {
        Addr LineAddress := in_msg.LineAddress;
        TBE tbe := TBEs[LineAddress];
        State st := getState(tbe, LineAddress);
        DPRINTF(RubySlicc, "resp2to_in: %s %s %s (addr: %#x)\n", in_msg.Type, in_msg.Sender, st, LineAddress);
        error("Invalid transition");
      }
    }
  }
  
  in_port(req2to_in, CoherenceMessage, req2To) {
    if (req2to_in.isReady(clockEdge())) {
      peek (req2to_in, CoherenceMessage, block_on="LineAddress") {
        Addr LineAddress := in_msg.LineAddress;
        TBE tbe := TBEs[LineAddress];
        State st := getState(tbe, LineAddress);
        DPRINTF(RubySlicc, "req2to_in: %s %s %s (addr: %#x)\n", in_msg.Type, in_msg.Sender, st, LineAddress);
        if (st == State:E) {
          if (in_msg.Type == CoherenceMessageType:GetML1) {
            enqueue(fwd2from_out, CoherenceMessage, responseLatency) {
              out_msg.LineAddress := LineAddress;
              out_msg.MessageSize := MessageSizeType:Control;
              out_msg.Destination.add(getEntry(LineAddress).ownerL1);
              out_msg.Type := CoherenceMessageType:Fwd_GetML1;
              out_msg.Sender := in_msg.Sender;
              out_msg.acksExpectedL1 := 0;
            }
            getEntry(LineAddress).ownerL1 := in_msg.Sender;
            setState(tbe, LineAddress, State:M);
            DPRINTF(RubySlicc, "Popping %s %s on req2to_in (addr: %#x)\n", in_msg.Type, in_msg.Sender, LineAddress);
            req2to_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);  
          } else if (in_msg.Type == CoherenceMessageType:GetSL1) {
            enqueue(fwd2from_out, CoherenceMessage, responseLatency) {
              out_msg.LineAddress := LineAddress;
              out_msg.MessageSize := MessageSizeType:Control;
              out_msg.Destination.add(getEntry(LineAddress).ownerL1);
              out_msg.Type := CoherenceMessageType:Fwd_GetSL1;
              out_msg.Sender := in_msg.Sender;
            }
            getEntry(LineAddress).cacheL1.add(in_msg.Sender);
            setState(tbe, LineAddress, State:O);
            DPRINTF(RubySlicc, "Popping %s %s on req2to_in (addr: %#x)\n", in_msg.Type, in_msg.Sender, LineAddress);
            req2to_in.dequeue(clockEdge());
            trigger(Event:deallocTBE, LineAddress, tbe);  
          } else if (in_msg.Type == CoherenceMessageType:PutEL1) {
            getEntry(LineAddress).cacheL1.remove(in_msg.Sender);
            if (getEntry(LineAddress).ownerL1 == in_msg.Sender) {
              enqueue(resp2from_out, CoherenceMessage, responseLatency) {
                out_msg.LineAddress := LineAddress;
                out_msg.MessageSize := MessageSizeType:Control;
                out_msg.Destination.add(in_msg.Sender);
                out_msg.Type := CoherenceMessageType:PutE_AckL1;
                out_msg.Sender := machineID;
              }
              setState(tbe, LineAddress, State:I);
              DPRINTF(RubySlicc, "Popping %s %s on req2to_in (addr: %#x)\n", in_msg.Type, in_msg.Sender, LineAddress);
              req2to_in.dequeue(clockEdge());
              trigger(Event:deallocTBE, LineAddress, tbe);
            }
            else if (getEntry(LineAddress).ownerL1 != in_msg.Sender) {
              enqueue(resp2from_out, CoherenceMessage, responseLatency) {
                out_msg.LineAddress := LineAddress;
                out_msg.MessageSize := MessageSizeType:Control;
                out_msg.Destination.add(in_msg.Sender);
                out_msg.Type := CoherenceMessageType:PutI_AckL1;
                out_msg.Sender := machineID;
              }
              setState(tbe, LineAddress, State:E);
              DPRINTF(RubySlicc, "Popping %s %s on req2to_in (addr: %#x)\n", in_msg.Type, in_msg.Sender, LineAddress);
              req2to_in.dequeue(clockEdge());
              trigger(Event:deallocTBE, LineAddress, tbe);
            }  
          } else if (in_msg.Type == CoherenceMessageType:PutML1) {
            getEntry(LineAddress).cacheL1.remove(in_msg.Sender);
            if (getEntry(LineAddress).ownerL1 == in_msg.Sender) {
              enqueue(resp2from_out, CoherenceMessage, responseLatency) {
                out_msg.LineAddress := LineAddress;
                out_msg.MessageSize := MessageSizeType:Control;
                out_msg.Destination.add(in_msg.Sender);
                out_msg.Type := CoherenceMessageType:PutM_AckL1;
                out_msg.Sender := machineID;
              }
              enqueue(memQueue_out, MemoryMsg, toMemLatency) {
                out_msg.addr := LineAddress;
                out_msg.Type := MemoryRequestType:MEMORY_WB;
                out_msg.Sender := in_msg.Sender;
                out_msg.MessageSize := MessageSizeType:Writeback_Data;
                out_msg.DataBlk := in_msg.cl;
                out_msg.Len := 0;
              }
              setState(tbe, LineAddress, State:E_PutML1_0);
              DPRINTF(RubySlicc, "Popping %s %s on req2to_in (addr: %#x)\n", in_msg.Type, in_msg.Sender, LineAddress);
              req2to_in.dequeue(clockEdge());
              trigger(Event:Progress, LineAddress, tbe);
            }
            else if (getEntry(LineAddress).ownerL1 != in_msg.Sender) {
              enqueue(resp2from_out, CoherenceMessage, responseLatency) {
                out_msg.LineAddress := LineAddress;
                out_msg.MessageSize := MessageSizeType:Control;
                out_msg.Destination.add(in_msg.Sender);
                out_msg.Type := CoherenceMessageType:PutI_AckL1;
                out_msg.Sender := machineID;
              }
              setState(tbe, LineAddress, State:E);
              DPRINTF(RubySlicc, "Popping %s %s on req2to_in (addr: %#x)\n", in_msg.Type, in_msg.Sender, LineAddress);
              req2to_in.dequeue(clockEdge());
              trigger(Event:deallocTBE, LineAddress, tbe);
            }  
          } else if (in_msg.Type == CoherenceMessageType:PutOL1) {
            getEntry(LineAddress).cacheL1.remove(in_msg.Sender);
            if (getEntry(LineAddress).ownerL1 == in_msg.Sender) {
              enqueue(resp2from_out, CoherenceMessage, responseLatency) {
                out_msg.LineAddress := LineAddress;
                out_msg.MessageSize := MessageSizeType:Control;
                out_msg.Destination.add(in_msg.Sender);
                out_msg.Type := CoherenceMessageType:PutE_AckL1;
                out_msg.Sender := machineID;
              }
              setState(tbe, LineAddress, State:I);
