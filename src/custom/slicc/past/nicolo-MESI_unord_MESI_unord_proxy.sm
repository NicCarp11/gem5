              req2to_in.dequeue(clockEdge());
              trigger(Event:deallocTBE, LineAddress, tbe);
            }
          } else {
            trigger(Event:Stallreq2to_in, LineAddress, tbe);
          }
        } else {
          trigger(Event:Stallreq2to_in, LineAddress, tbe);
        }
      }
    }
  }
  
  
  //Backend.SLICC.ModularSLICC.dir.GenDirActions
  action(a_allocTBE, "aTBE", desc="Allocate TBE entry.") {
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
  }
  
  action(a_deallocTBE, "dTBE", desc="Deallocate TBE entry.") {
    if (is_valid(tbe)) {
      TBEs.deallocate(address);
      unset_tbe();
    }
  }
  
  action(popmemQueue_in, "pmemQueue_in0", desc="Pop the memQueue_in queue.") {
      // Sometimes we need to be able to pop a queue/in_port from within a transition
      // rather than from within the in_port itself. Thus, we need an action for this,
      // since transitions cannot execute non-action functions.
      memQueue_in.dequeue(clockEdge());
  }
  
  action(recyclememQueue_in, "rmemQueue_in0", desc="Recycle the memQueue_in port") {
    DPRINTF(RubySlicc, "Stalling memQueue_in (addr: %#x)\n", address);
    memQueue_in.recycle(clockEdge(), cyclesToTicks(recycleLatency));
    //stall_and_wait(memQueue_in, address);
  }
  
  action(popfwd2to_in, "pfwd2to_in0", desc="Pop the fwd2to_in queue.") {
      // Sometimes we need to be able to pop a queue/in_port from within a transition
      // rather than from within the in_port itself. Thus, we need an action for this,
      // since transitions cannot execute non-action functions.
      fwd2to_in.dequeue(clockEdge());
  }
  
  action(recyclefwd2to_in, "rfwd2to_in0", desc="Recycle the fwd2to_in port") {
    DPRINTF(RubySlicc, "Stalling fwd2to_in (addr: %#x)\n", address);
    fwd2to_in.recycle(clockEdge(), cyclesToTicks(recycleLatency));
    //stall_and_wait(fwd2to_in, address);
  }
  
  action(popreq2to_in, "preq2to_in0", desc="Pop the req2to_in queue.") {
      // Sometimes we need to be able to pop a queue/in_port from within a transition
      // rather than from within the in_port itself. Thus, we need an action for this,
      // since transitions cannot execute non-action functions.
      req2to_in.dequeue(clockEdge());
  }
  
  action(recyclereq2to_in, "rreq2to_in0", desc="Recycle the req2to_in port") {
    DPRINTF(RubySlicc, "Stalling req2to_in (addr: %#x)\n", address);
    req2to_in.recycle(clockEdge(), cyclesToTicks(recycleLatency));
    //stall_and_wait(req2to_in, address);
  }
  
  action(popresp2to_in, "presp2to_in0", desc="Pop the resp2to_in queue.") {
      // Sometimes we need to be able to pop a queue/in_port from within a transition
      // rather than from within the in_port itself. Thus, we need an action for this,
      // since transitions cannot execute non-action functions.
      resp2to_in.dequeue(clockEdge());
  }
  
  action(recycleresp2to_in, "rresp2to_in0", desc="Recycle the resp2to_in port") {
    DPRINTF(RubySlicc, "Stalling resp2to_in (addr: %#x)\n", address);
    resp2to_in.recycle(clockEdge(), cyclesToTicks(recycleLatency));
    //stall_and_wait(resp2to_in, address);
  }
  
  action(empty, "e", desc="Empty action") {
      // empty action; useful as SLICC requires valid transitions
      // to be non-empty, but the actions being invoked can still be empty
      // e.g. to simulate a z-stall
  }
  
  //Backend.SLICC.ModularSLICC.dir.GenDirTransitions
  
  
  transition({E, E_PutML1_0, I, I_GetML1_0, I_GetSL1_0, I_PutOL1_0, M, M_PutEL1_0, M_PutML1_0, M_PutOL1_0, M_PutSL1_0, O, O_GetML1_0, O_PutML1_0, O_PutOL1_0, S, S_GetML1_0, S_GetML1_1, S_GetML1_2, S_GetSL1_0}, Stallfwd2to_in) {
      recyclefwd2to_in;
  }
  
  transition({E, E_PutML1_0, I, I_GetML1_0, I_GetSL1_0, I_PutOL1_0, M, M_PutEL1_0, M_PutML1_0, M_PutOL1_0, M_PutSL1_0, O, O_GetML1_0, O_PutML1_0, O_PutOL1_0, S, S_GetML1_0, S_GetML1_1, S_GetML1_2, S_GetSL1_0}, StallmemQueue_in) {
      recyclememQueue_in;
  }
  
  transition({E, E_PutML1_0, I, I_GetML1_0, I_GetSL1_0, I_PutOL1_0, M, M_PutEL1_0, M_PutML1_0, M_PutOL1_0, M_PutSL1_0, O, O_GetML1_0, O_PutML1_0, O_PutOL1_0, S, S_GetML1_0, S_GetML1_1, S_GetML1_2, S_GetSL1_0}, Stallreq2to_in) {
      recyclereq2to_in;
  }
  
  transition({E, E_PutML1_0, I, I_GetML1_0, I_GetSL1_0, I_PutOL1_0, M, M_PutEL1_0, M_PutML1_0, M_PutOL1_0, M_PutSL1_0, O, O_GetML1_0, O_PutML1_0, O_PutOL1_0, S, S_GetML1_0, S_GetML1_1, S_GetML1_2, S_GetSL1_0}, Stallresp2to_in) {
      recycleresp2to_in;
  }
  
  transition({E, E_PutML1_0, I, I_GetML1_0, I_GetSL1_0, I_PutOL1_0, M, M_PutEL1_0, M_PutML1_0, M_PutOL1_0, M_PutSL1_0, O, O_GetML1_0, O_PutML1_0, O_PutOL1_0, S, S_GetML1_0, S_GetML1_1, S_GetML1_2, S_GetSL1_0}, Progress) {
      empty;
  }
  
  transition({E, I, M, O, S}, allocTBE) {
    a_allocTBE;
  }
  
  transition({E, I, M, O, S}, deallocTBE) {
    a_deallocTBE;
  }
}
// EOF<directory>
